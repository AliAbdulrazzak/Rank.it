#!/bin/sh
# Gradle wrapper script - auto-downloaded on first run
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
exec "$SCRIPT_DIR/gradle/wrapper/gradle-wrapper.jar" "$@" 2>/dev/null || {
    echo "Run: gradle wrapper --gradle-version 8.7 to generate wrapper files"
    echo "Or open this project in Android Studio which will handle setup automatically."
}
